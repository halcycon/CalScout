{
  "name": "calscout",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs && python3 -m unittest discover -s tests/unit -p \"test_*.py\"",
    "build": "python3 scripts/package.py",
    "test:thunderbird": "python3 tests/integration/thunderbird.py",
    "check": "node scripts/check.mjs && npm run lint && npm run format:check",
    "test:stalwart": "python3 tests/integration/stalwart.py",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,mjs,json,html,css}\" \"tests/unit/*.mjs\" \"scripts/*.mjs\" eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.{js,mjs,json,html,css}\" \"tests/unit/*.mjs\" \"scripts/*.mjs\" eslint.config.mjs",
    "build:submission": "python3 scripts/submission.py",
    "check:atn": "python3 scripts/check_atn.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@xmldom/xmldom": "0.9.12",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "description": "Automatic CalDAV discovery and native calendar subscriptions for Thunderbird",
  "repository": {
    "type": "git",
    "url": "https://github.com/halcycon/CalScout.git"
  },
  "homepage": "https://github.com/halcycon/CalScout",
  "author": "Adam Camp"
}
